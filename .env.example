APP_NAME="YouTube Board"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=youtube_board
DB_USERNAME=youtube_board
DB_PASSWORD=youtube_board

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LEGACY_GROUND_TRUTH_PATH=/Users/skyhong/Documents/youtube-board-legacy
LEGACY_PUBLIC_SITE_URL=https://youtube.board.tw

INGESTION_SCHEDULER_ENABLED=true
INGESTION_LOCAL_POLLING_ENABLED=true
INGESTION_PRODUCTION_POLLING_ENABLED=false
INGESTION_SCHEDULED_WRITE_ALLOWLIST=off
INGESTION_TIMEZONE=Asia/Taipei
INGESTION_JOB_LOCK_SECONDS=14400
INGESTION_YOUTUBE_DAILY_QUOTA_BUDGET=9000
INGESTION_COMMENT_CLAIM_MINUTES=30

# Local dump imports allow only these exact Compose database service hosts.
# Add a host-native name explicitly only when it cannot resolve through a tunnel.
LOCAL_DUMP_IMPORT_ALLOWED_HOSTS=mysql,mariadb

YOUTUBE_API_KEY=
YOUTUBE_API_KEYS=
YOUTUBE_API_TRANSIENT_RETRIES=1
YOUTUBE_API_RETRY_DELAY_MS=250
YOUTUBE_DATA_API_DAILY_QUOTA_UNITS=10000
YOUTUBE_DATA_API_QUOTA_WARNING_PERCENT=80
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=qwen3.6-plus
OPENAI_API_KEY=
