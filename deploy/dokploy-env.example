APP_NAME="YouTube Board"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://youtube-board.skyhong.tw

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
FILESYSTEM_DISK=local

DB_CONNECTION=mysql
DB_HOST=your-dokploy-mariadb-internal-host
DB_PORT=3306
DB_DATABASE=youtube_board
DB_USERNAME=youtube_board
DB_PASSWORD=

LEGACY_GROUND_TRUTH_PATH=
LEGACY_PUBLIC_SITE_URL=https://youtube.board.tw

INGESTION_SCHEDULER_ENABLED=false
INGESTION_LOCAL_POLLING_ENABLED=false
INGESTION_PRODUCTION_POLLING_ENABLED=false
INGESTION_SCHEDULED_WRITE_ALLOWLIST=
INGESTION_TIMEZONE=Asia/Taipei

# Production parity activation, after backup/rollback verification:
# INGESTION_SCHEDULER_ENABLED=true
# INGESTION_LOCAL_POLLING_ENABLED=true
# INGESTION_PRODUCTION_POLLING_ENABLED=true
# Keep reports.keywords.build allowlisted while keyword maintenance still comes from 新文易數 tag.analysis.tw.
# INGESTION_SCHEDULED_WRITE_ALLOWLIST=youtube.live.poll,youtube.channels.videos.live,youtube.channels.videos.live_group,reports.live.build,reports.keywords.build,ai.hourly,ai.daily

YOUTUBE_API_KEY=
# Optional comma-separated fallback keys. Keep these in Dokploy secrets/env only.
YOUTUBE_API_KEYS=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=qwen3.6-plus
OPENAI_ENDPOINT_STYLE=auto
OPENAI_TIMEOUT=180
OPENAI_MAX_TOKENS=1200
OPENAI_API_KEY=
# Optional fallback provider. Keep fallback keys in Dokploy secrets/env only.
# OPENAI_FALLBACK_BASE_URL=https://api.openai.com/v1
# OPENAI_FALLBACK_MODEL=gpt-4o-mini
# OPENAI_FALLBACK_ENDPOINT_STYLE=chat
# OPENAI_FALLBACK_TIMEOUT=300
# OPENAI_FALLBACK_MAX_TOKENS=1200
# OPENAI_FALLBACK_API_KEY=
