APP_NAME="YouTube Board"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://youtube.observe.tw

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local

DB_CONNECTION=mysql
DB_HOST=your-dokploy-mariadb-internal-host
DB_PORT=3306
DB_DATABASE=youtube_board
DB_USERNAME=youtube_board
DB_PASSWORD=

LEGACY_GROUND_TRUTH_PATH=
LEGACY_PUBLIC_SITE_URL=https://youtube.board.tw

INGESTION_SCHEDULER_ENABLED=true
INGESTION_LOCAL_POLLING_ENABLED=true
INGESTION_PRODUCTION_POLLING_ENABLED=true
INGESTION_SCHEDULED_WRITE_ALLOWLIST=off
INGESTION_TIMEZONE=Asia/Taipei
INGESTION_JOB_LOCK_SECONDS=14400
INGESTION_AI_BUSINESS_LOCK_SECONDS=900
INGESTION_AI_BUSINESS_LOCK_TIMEOUT_SECONDS=0
INGESTION_LOCK_STORE=database
INGESTION_YOUTUBE_DAILY_QUOTA_BUDGET=9000
INGESTION_COMMENT_CLAIM_MINUTES=30
INGESTION_RUN_HISTORY_RETENTION_DAYS=14
INGESTION_RUN_HISTORY_MAX_RECORDS=25000

# This committed template is fail-closed for scheduled writes. Replace `off` with
# an exact reviewed comma-separated job list only after dry-run evidence, backup,
# risk/rollback review, and explicit operator approval in Dokploy.

YOUTUBE_API_KEY=
YOUTUBE_API_TRANSIENT_RETRIES=1
YOUTUBE_API_RETRY_DELAY_MS=250
# Optional comma-separated fallback keys. Keep these in Dokploy secrets/env only.
YOUTUBE_API_KEYS=
YOUTUBE_DATA_API_DAILY_QUOTA_UNITS=10000
YOUTUBE_DATA_API_QUOTA_WARNING_PERCENT=80
# Optional YouTube quota monitor for /ops/integrations.
# Requires a Google Cloud service account with read-only Cloud Monitoring access.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_MONITORING_SERVICE_ACCOUNT_JSON_BASE64=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_ENDPOINT_STYLE=chat
OPENAI_TIMEOUT=180
OPENAI_MAX_TOKENS=4096
OPENAI_DAILY_MAX_TOKENS=12288
OPENAI_TRANSIENT_RETRIES=1
OPENAI_RETRY_DELAY_MS=250
OPENAI_RETRY_AFTER_MAX_MS=2000
OPENAI_API_KEY=
# Optional fallback provider. Keep fallback keys in Dokploy secrets/env only.
OPENAI_FALLBACK_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_FALLBACK_MODEL=qwen3.6-plus
OPENAI_FALLBACK_ENDPOINT_STYLE=auto
OPENAI_FALLBACK_TIMEOUT=300
OPENAI_FALLBACK_MAX_TOKENS=1200
OPENAI_FALLBACK_API_KEY=
