[Unit]
Description=Allow private Docker access to YouTube Board Codex gateway
After=docker.service netfilter-persistent.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -i docker_gwbridge -s 172.19.0.0/16 -d 172.19.0.1 -p tcp --dport 8321 -m comment --comment youtube-codex-gateway -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I INPUT 1 -i docker_gwbridge -s 172.19.0.0/16 -d 172.19.0.1 -p tcp --dport 8321 -m comment --comment youtube-codex-gateway -j ACCEPT'
ExecStop=/usr/sbin/iptables -D INPUT -i docker_gwbridge -s 172.19.0.0/16 -d 172.19.0.1 -p tcp --dport 8321 -m comment --comment youtube-codex-gateway -j ACCEPT

[Install]
WantedBy=multi-user.target
