[Unit]
Description=YouTube Board private Codex inference gateway
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/youtube-codex-gateway.env
ExecStart=/usr/bin/python3 %h/apps/youtube-codex-gateway/codex_gateway.py
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
