# Isolated, disposable local development credentials only.
NODE_ENV=development
DATASET_KIND=fixture
DATABASE_URL=mysql://youtube_rewrite:youtube_rewrite_local@127.0.0.1:23306/youtube_board_rewrite
REDIS_URL=redis://127.0.0.1:26379/0
YOUTUBE_API_BASE_URL=http://127.0.0.1:4100/api/v1
# Required when serving production-build RSS. Use the actual preview origin locally.
# YOUTUBE_PUBLIC_URL=https://youtube.observe.tw
PORT=4100
HOST=127.0.0.1
# External API and production writes stay opt-in; see jobs documentation.
# Editorial operator attribution, only when explicitly enabling the authenticated console.
# TS_OPS_ACTOR=local-editor
# All writes remain disabled by default; see shared/editorial/README.md for exact gates.

# Google accounts (blank means disabled; configure credentials only in protected runtime env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SESSION_SECRET=
AUTH_PUBLIC_ORIGIN=
AUTH_ADMIN_EMAILS=
# Required in production: exact Traefik peer IP/CIDR, never trust every address.
# Verify nearest untrusted hop is Cloudflare before accepting CF-Connecting-IP.
AUTH_TRUSTED_PROXY_CIDRS=

# Optional local channel-avatar cache; use an absolute, non-symlink path.
# Public server mounts read-only; channels.avatars.refresh worker mounts read/write.
# Missing cache renders fallback icons. No automatic downloads from HTTP requests.
MEDIA_CACHE_ROOT=

# Explicit headless CI service auth only; interactive management uses Google admin.
TS_OPS_SERVICE_AUTH_ENABLED=false

# Optional personal tag.observe.tw API key; choose env OR mounted file, never both.
TAG_SOURCE_API_KEY=
TAG_SOURCE_API_KEY_FILE=
# Empty selects 1100ms anonymous / 100ms with key; lower values are rejected.
TAG_SOURCE_INTERVAL_MS=
