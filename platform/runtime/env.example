# Candidate deployment template; never copy production secrets into this file.
# Keep secrets in Dokploy runtime configuration. This file activates no writer.
APP_ENV=production
NODE_ENV=production
PORT=8000
RUNTIME_ROLE=web
DATASET_KIND=unknown
YOUTUBE_PUBLIC_URL=https://youtube.observe.tw
# Frontend-first production requires the separate new schema and two principals.
# Both URLs point to the same youtube_board_ts schema on the private MariaDB host.
# Report principal: source views + 14 explicit public TS tables, SELECT only.
TS_FRONTEND_SCHEMA_MODE=isolated
DATABASE_URL=
# Own-state principal: precise auth/reader DML, own-schema source-view reads only.
TS_DATABASE_URL=
# Optional; when set, must match TS_DATABASE_URL identity AND credential.
AUTH_DATABASE_URL=
# Do not configure legacy DB_* writer credentials in the frontend web service.
# Redis is unnecessary with frontend-only ops/relay/worker/producer disabled.
REDIS_URL=
MEDIA_CACHE_ROOT=/var/lib/youtube-board/media
TS_INGESTION_ENABLED=false
TS_INGESTION_PRODUCTION_ENABLED=false
TS_SCHEDULER_ENABLED=false
TS_INGESTION_OWNERS=
TS_INGESTION_WRITE_ALLOWLIST=
# Empty for frontend-first. Service-token ops stay disabled independently of login.
TS_OPS_TOKEN=
TS_OPS_EXECUTION_ENABLED=false
TS_OPS_WRITE_ALLOWLIST=
TS_DEPLOY_RELAY_ENABLED=false
TS_DEPLOY_REPOSITORY=skyhong2002/youtube-board
DOKPLOY_DEPLOY_RELAY_SECRET=
DOKPLOY_DEPLOY_WEBHOOK_URL=

# Google accounts (blank means disabled; configure credentials only in protected runtime env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SESSION_SECRET=
AUTH_PUBLIC_ORIGIN=https://youtube.observe.tw
AUTH_ADMIN_EMAILS=
# Required in production: exact Traefik peer IP/CIDR, never trust every address.
# Verify nearest untrusted hop is Cloudflare before accepting CF-Connecting-IP.
# Last inspected Traefik peer: 10.0.1.17; reverify before setting this value.
# The 10.0.1.0/24 Docker overlay is NOT the trusted-proxy allowlist.
AUTH_TRUSTED_PROXY_CIDRS=

# Explicit headless CI service auth only; interactive management uses Google admin.
TS_OPS_SERVICE_AUTH_ENABLED=false
