{
  "version": 1,
  "timezone": "Asia/Taipei",
  "schedules": [
    { "id": "batch2-channels-stats-v1", "workflow": "youtube.channels.stats", "cron": "*/9 * * * *", "options": { "limit": 25 } },
    { "id": "batch2-live-poll-v1", "workflow": "youtube.live.poll", "cron": "* * * * *", "options": { "limit": 50 } },
    { "id": "batch2-tvbs-live-poll-v1", "workflow": "youtube.tvbs.live.poll", "cron": "* * * * *", "options": { "limit": 20 } },
    { "id": "batch2-live-cleanup-v1", "workflow": "youtube.live.cleanup", "cron": "27 */2 * * *", "options": { "limit": 100 } },
    { "id": "batch2-videos-live-group-v1", "workflow": "youtube.channels.videos.live_group", "cron": "1,31 0-15 * * *", "options": { "limit": 3, "max-results": 50 } },
    { "id": "batch2-videos-live-v1", "workflow": "youtube.channels.videos.live", "cron": "5 2-16 * * *", "options": { "limit": 3, "max-results": 50 } },
    { "id": "batch2-videos-general-v1", "workflow": "youtube.channels.videos.general", "cron": "*/5 * * * *", "options": { "limit": 12, "max-results": 50 } },
    { "id": "batch2-tvbs-videos-v1", "workflow": "youtube.tvbs.videos", "cron": "*/5 * * * *", "options": { "limit": 1, "max-results": 1, "offset": "auto" } },
    { "id": "batch2-tag-videos-backfill-v1", "workflow": "youtube.tag_videos.backfill", "cron": "17 3,6,9,12,15,18,21 * * *", "options": { "tagid": 102, "days": 2, "limit": 100, "max-pages": 20, "max-results": 50 } },
    { "id": "batch2-videos-stats-v1", "workflow": "youtube.videos.stats", "cron": "*/7 0-17 * * *", "options": { "limit": 25 } },
    { "id": "batch2-videos-duration-v1", "workflow": "youtube.videos.duration", "cron": "*/23 * * * *", "options": { "limit": 25, "enqueue-missing": true } }
  ]
}
